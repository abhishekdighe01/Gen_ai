# SuryaGharSathi Environment Configuration
# Copy this file to .env and add your actual API key

# LLM Provider Configuration
# Choose one: groq or gemini
LLM_PROVIDER=groq

# Groq API Key (get from https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# Alternative: Google Gemini API Key (get from https://makersuite.google.com/app/apikey)
# GEMINI_API_KEY=your_gemini_api_key_here

# LLM Model Configuration
GROQ_MODEL=llama-3.1-70b-versatile
# Alternative Groq models: mixtral-8x7b-32768, llama-3.1-8b-instant

# LLM Parameters
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1000
LLM_TOP_P=0.9

# RAG Configuration
RAG_TOP_K=5
RAG_MIN_SIMILARITY=0.15

# Application Settings
DEBUG=false
LOG_LEVEL=INFO
